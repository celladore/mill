  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celladore/mill.git"
  },
  "homepage": "https://mill.celladoresystems.com",
  "bugs": "https://github.com/celladore/mill/issues",
  "license": "UNLICENSED"
}
