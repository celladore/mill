REACT_APP_BACKEND_URL=http://localhost:8000

# Leave both blank until Mystira has seeded the Public + PKCE client.
# Production values are https://identity.mystira.app/ and celladore-xtox.
REACT_APP_MYSTIRA_OIDC_ISSUER=
REACT_APP_MYSTIRA_OIDC_CLIENT_ID=
REACT_APP_MYSTIRA_OIDC_REDIRECT_URI=http://localhost:3000
REACT_APP_MYSTIRA_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
REACT_APP_MYSTIRA_OIDC_SCOPES=openid profile email offline_access
