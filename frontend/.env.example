VITE_BACKEND_URL=http://localhost:8000

# Production uses https://identity.mystira.app/ and celladore-xtox.
VITE_MYSTIRA_OIDC_ISSUER=
VITE_MYSTIRA_OIDC_CLIENT_ID=
VITE_MYSTIRA_OIDC_REDIRECT_URI=http://localhost:3000
VITE_MYSTIRA_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
# Defaults to <origin>/silent-renew.html — only set this if that page is served
# from a different path/origin than the app itself.
VITE_MYSTIRA_OIDC_SILENT_REDIRECT_URI=
VITE_MYSTIRA_OIDC_SCOPES=openid profile email offline_access
